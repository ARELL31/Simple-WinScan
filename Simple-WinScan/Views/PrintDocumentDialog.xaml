<ContentDialog
    x:Class="Simple_WinScan.Views.PrintDocumentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Imprimir Documento"
    PrimaryButtonText="Imprimir"
    CloseButtonText="Cancelar"
    DefaultButton="Primary">

    <StackPanel Spacing="16" MinWidth="340">
        <!-- Impresora -->
        <StackPanel Spacing="6">
            <TextBlock Text="Impresora destino:" FontWeight="SemiBold" FontSize="13" />
            <ComboBox x:Name="PrintersComboBox" HorizontalAlignment="Stretch" />
        </StackPanel>

        <!-- Orientación -->
        <StackPanel Spacing="6">
            <TextBlock Text="Orientación:" FontWeight="SemiBold" FontSize="13" />
            <RadioButtons x:Name="OrientationRadioButtons" SelectedIndex="0">
                <RadioButton Content="Vertical (Portrait)" />
                <RadioButton Content="Horizontal (Landscape)" />
            </RadioButtons>
        </StackPanel>

        <!-- Copias -->
        <StackPanel Spacing="6">
            <TextBlock Text="Número de copias:" FontWeight="SemiBold" FontSize="13" />
            <NumberBox x:Name="CopiesNumberBox" Value="1" Minimum="1" Maximum="99" SpinButtonPlacementMode="Inline" SmallChange="1" LargeChange="5" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
