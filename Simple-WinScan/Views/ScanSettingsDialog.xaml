<ContentDialog
    x:Class="Simple_WinScan.Views.ScanSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Simple_WinScan.Models"
    xmlns:vm="using:Simple_WinScan.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Preferencias y Ajustes de Digitalización"
    PrimaryButtonText="Guardar"
    CloseButtonText="Cancelar"
    DefaultButton="Primary">

    <ScrollViewer MaxHeight="480" Padding="0,8,12,8">
        <StackPanel Spacing="16" Width="440">
            <!-- Sección Calidad y Tamaño -->
            <TextBlock Text="Resolución y Formato de Papel" FontWeight="SemiBold" FontSize="14" />
            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Resolución (DPI)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox
                        ItemsSource="{x:Bind ViewModel.AvailableDpis}"
                        SelectedItem="{x:Bind ViewModel.SelectedDpi, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Tamaño de Papel" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox
                        ItemsSource="{x:Bind ViewModel.AvailablePaperSizes}"
                        SelectedItem="{x:Bind ViewModel.SelectedPaperSize, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" />
                </StackPanel>
            </Grid>

            <!-- Sección Brillo y Contraste -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="Ajustes de Imagen (Hardware)" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.ResetBrightnessContrastCommand}"
                            Content="Restablecer"
                            Style="{ThemeResource SubtleButtonStyle}"
                            FontSize="12"
                            Padding="8,4" />
                    </Grid>

                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Brillo" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Brightness, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                        </Grid>
                        <Slider
                            Minimum="-100"
                            Maximum="100"
                            Value="{x:Bind ViewModel.Brightness, Mode=TwoWay}"
                            StepFrequency="1"
                            TickFrequency="25" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Contraste" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Contrast, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                        </Grid>
                        <Slider
                            Minimum="-100"
                            Maximum="100"
                            Value="{x:Bind ViewModel.Contrast, Mode=TwoWay}"
                            StepFrequency="1"
                            TickFrequency="25" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Sección Modo Continuo / Libro -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <StackPanel Spacing="6">
                    <TextBlock Text="Modo Continuo (Libro)" FontWeight="SemiBold" FontSize="14" />
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="Retardo entre páginas (segundos)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ContinuousDelaySeconds, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <Slider
                        Minimum="2"
                        Maximum="30"
                        Value="{x:Bind ViewModel.ContinuousDelaySeconds, Mode=TwoWay}"
                        StepFrequency="1" />
                </StackPanel>
            </Border>

            <!-- Sección Posprocesamiento y OCR -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <StackPanel Spacing="10">
                    <TextBlock Text="Opciones Avanzadas" FontWeight="SemiBold" FontSize="14" />
                    <ToggleSwitch
                        Header="Generar texto buscable con OCR nativo (Windows.Media.Ocr)"
                        IsOn="{x:Bind ViewModel.IsOcrEnabled, Mode=TwoWay}" />
                    <ToggleSwitch
                        Header="Habilitar gancho de posprocesamiento externo"
                        IsOn="{x:Bind ViewModel.IsPostprocessingEnabled, Mode=TwoWay}" />
                    <TextBox
                        Header="Comando de posprocesamiento ({input}, {output}, {dpi})"
                        PlaceholderText="ej: unpaper --dpi {dpi} {input} {output}"
                        Text="{x:Bind ViewModel.PostprocessingCommand, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.IsPostprocessingEnabled, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
