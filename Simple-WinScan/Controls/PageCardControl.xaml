<UserControl
    x:Class="Simple_WinScan.Controls.PageCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Simple_WinScan.ViewModels"
    mc:Ignorable="d">

    <Border
        Width="220"
        Margin="12"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="12">
        
        <Grid RowDefinitions="Auto, *, Auto">
            <!-- Encabezado de tarjeta con número de página -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Border
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="4"
                    Padding="8,2"
                    HorizontalAlignment="Left">
                    <TextBlock
                        Text="{x:Bind GetPageLabel(ViewModel.PageNumber), Mode=OneWay}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </Grid>

            <!-- Miniatura de la página con rotación aplicada -->
            <Border
                Grid.Row="1"
                Height="280"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                
                <Grid>
                    <Image
                        Source="{x:Bind ViewModel.ThumbnailImage, Mode=OneWay}"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Image.RenderTransform>
                            <RotateTransform
                                Angle="{x:Bind ViewModel.RotationAngle, Mode=OneWay}"
                                CenterX="100"
                                CenterY="135" />
                        </Image.RenderTransform>
                    </Image>

                    <!-- Indicador si aún carga la miniatura -->
                    <ProgressRing
                        IsActive="{x:Bind IsThumbnailLoading(ViewModel.ThumbnailImage), Mode=OneWay}"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Barra de acciones contextuales al pie de la página -->
            <StackPanel
                Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="8"
                Margin="0,10,0,0">

                <Button
                    Command="{x:Bind ViewModel.RotateCounterClockwiseCommand}"
                    ToolTipService.ToolTip="Rotar 90° a la izquierda"
                    Style="{ThemeResource SubtleButtonStyle}"
                    Padding="6">
                    <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                </Button>

                <Button
                    Command="{x:Bind ViewModel.RotateClockwiseCommand}"
                    ToolTipService.ToolTip="Rotar 90° a la derecha"
                    Style="{ThemeResource SubtleButtonStyle}"
                    Padding="6">
                    <FontIcon Glyph="&#xE7A6;" FontSize="14" />
                </Button>

                <Button
                    Command="{x:Bind ViewModel.RequestDeleteCommand}"
                    ToolTipService.ToolTip="Eliminar página"
                    Style="{ThemeResource SubtleButtonStyle}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Padding="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
