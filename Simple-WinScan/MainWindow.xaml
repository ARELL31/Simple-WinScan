<Window
    x:Class="Simple_WinScan.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Simple_WinScan"
    xmlns:controls="using:Simple_WinScan.Controls"
    xmlns:models="using:Simple_WinScan.Models"
    xmlns:vm="using:Simple_WinScan.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WinSimpleScan">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">
        <!-- Fila 0: Barra de Título Personalizada Fluent -->
        <Grid Grid.Row="0" x:Name="AppTitleBar" Height="44" Padding="16,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xEC59;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                <TextBlock Text="WinSimpleScan" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="— Escáner de Documentos" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Fila 1: CommandBar de Alta Eficiencia (Cero Fricción) -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,1"
            Padding="16,8">

            <Grid ColumnDefinitions="Auto, *, Auto">
                <!-- Acciones Principales (Izquierda) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Botón Principal de Escaneo con Menú de Modos (Cama Plana, Lote ADF, Modo Continuo) -->
                    <SplitButton
                        Command="{x:Bind ViewModel.ScanCommand}"
                        IsEnabled="{x:Bind ViewModel.CanScan, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Escanear página desde cama plana (Ctrl+1)"
                        AutomationProperties.Name="Escanear página">
                        <SplitButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Number1" Modifiers="Control" />
                        </SplitButton.KeyboardAccelerators>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEC59;" FontSize="16" />
                            <TextBlock Text="Escanear" FontWeight="SemiBold" />
                        </StackPanel>
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem
                                    Text="Escanear página individual (Cama plana)"
                                    Command="{x:Bind ViewModel.ScanCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEC59;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Text="Escanear lote completo desde alimentador (ADF)"
                                    Command="{x:Bind ViewModel.ScanBatchAdfCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B9;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Text="Modo continuo con temporizador (Modo Libro)"
                                    Command="{x:Bind ViewModel.StartContinuousScanCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE916;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>

                    <!-- Botón Cancelar / Detener (solo activo durante escaneo o modo continuo, atajo Escape) -->
                    <Button
                        Command="{x:Bind ViewModel.CancelScanCommand}"
                        Visibility="{x:Bind GetCancelVisibility(ViewModel.IsScanning, ViewModel.IsContinuousScanActive), Mode=OneWay}"
                        Style="{ThemeResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="Cancelar o detener digitalización en curso (Escape)"
                        AutomationProperties.Name="Detener digitalización"
                        Padding="10,8">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Escape" />
                        </Button.KeyboardAccelerators>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <TextBlock Text="Detener" />
                        </StackPanel>
                    </Button>

                    <AppBarSeparator />

                    <!-- Selector de Perfil Rápido (Texto vs Foto) -->
                    <ComboBox
                        ItemsSource="{x:Bind ViewModel.AvailableProfiles}"
                        SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                        DisplayMemberPath="Name"
                        ToolTipService.ToolTip="Perfil de calidad y resolución"
                        VerticalAlignment="Center"
                        Width="160" />

                    <!-- Selector de Dispositivo de Escaneo -->
                    <ComboBox
                        ItemsSource="{x:Bind ViewModel.AvailableScanners}"
                        SelectedItem="{x:Bind ViewModel.SelectedScanner, Mode=TwoWay}"
                        DisplayMemberPath="Name"
                        ToolTipService.ToolTip="Dispositivo de escaneo seleccionado"
                        VerticalAlignment="Center"
                        Width="220" />

                    <Button
                        Command="{x:Bind ViewModel.LoadScannersCommand}"
                        ToolTipService.ToolTip="Actualizar lista de escáneres (F5)"
                        AutomationProperties.Name="Actualizar lista de escáneres"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Padding="8">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </Button.KeyboardAccelerators>
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </StackPanel>

                <!-- Resumen de Estado / Contador de Páginas (Centro) -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        Text="{x:Bind ViewModel.PageCountSummary, Mode=OneWay}"
                        FontWeight="SemiBold"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Acciones de Salida y Limpieza (Derecha) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Guardar / Exportar Documento (SplitButton) -->
                    <SplitButton
                        Command="{x:Bind ViewModel.SavePdfCommand}"
                        IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                        Padding="12,8"
                        ToolTipService.ToolTip="Guardar documento como PDF (Ctrl+S)">
                        <SplitButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="S" Modifiers="Control" />
                        </SplitButton.KeyboardAccelerators>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Guardar PDF" FontWeight="SemiBold" />
                        </StackPanel>
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem
                                    Text="Guardar como PDF (.pdf)"
                                    Command="{x:Bind ViewModel.SavePdfCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEA90;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    Text="Exportar como JPEG (.jpg)"
                                    Command="{x:Bind ViewModel.SaveJpegCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEB9F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Text="Exportar como PNG (.png)"
                                    Command="{x:Bind ViewModel.SavePngCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEB9F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Text="Exportar como WebP (.webp)"
                                    Command="{x:Bind ViewModel.SaveWebpCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEB9F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    Text="Imprimir documento (Ctrl+P)"
                                    Command="{x:Bind ViewModel.PrintDocumentCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE749;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>

                    <!-- Reordenar Páginas -->
                    <Button
                        Command="{x:Bind ViewModel.OpenReorderDialogCommand}"
                        IsEnabled="{x:Bind ViewModel.HasPages, Mode=OneWay}"
                        ToolTipService.ToolTip="Reordenar páginas: invertir, intercalar caras o rotar alternadas (Ctrl+R)"
                        AutomationProperties.Name="Reordenar páginas"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Padding="8">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="R" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                        <FontIcon Glyph="&#xE8D8;" FontSize="15" />
                    </Button>

                    <!-- Limpiar Todo -->
                    <Button
                        Command="{x:Bind ViewModel.ClearAllPagesCommand}"
                        IsEnabled="{x:Bind ViewModel.HasPages, Mode=OneWay}"
                        ToolTipService.ToolTip="Descartar todas las páginas escaneadas"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Padding="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="15" />
                    </Button>

                    <!-- Más Opciones (...) -->
                    <Button
                        ToolTipService.ToolTip="Opciones adicionales"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Padding="8">
                        <FontIcon Glyph="&#xE712;" FontSize="15" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <ToggleMenuFlyoutItem
                                    Text="Habilitar escáner virtual (modo simulación)"
                                    IsChecked="{x:Bind ViewModel.IsVirtualScannerEnabled, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.ToggleVirtualScannerCommand}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    Text="Preferencias de digitalización..."
                                    Command="{x:Bind ViewModel.OpenSettingsCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE713;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Fila 2: Barra de Progreso Fluent con Porcentaje Real -->
        <ProgressBar
            Grid.Row="2"
            IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
            Value="{x:Bind ViewModel.ScanProgressPercentage, Mode=OneWay}"
            Minimum="0"
            Maximum="100"
            Visibility="{x:Bind GetProgressVisibility(ViewModel.IsScanning, ViewModel.IsExporting), Mode=OneWay}"
            Height="4"
            VerticalAlignment="Top" />

        <!-- Fila 3: Lienzo Central -->
        <Grid Grid.Row="3">
            <!-- Estado Vacío (0 páginas) -->
            <StackPanel
                Visibility="{x:Bind GetEmptyStateVisibility(ViewModel.HasPages), Mode=OneWay}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                MaxWidth="420"
                Padding="24">

                <Border
                    Width="88"
                    Height="88"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="44"
                    HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xEC59;" FontSize="38" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock
                    Text="No hay páginas escaneadas"
                    FontSize="20"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center" />

                <TextBlock
                    Text="Coloca un documento en tu escáner y presiona 'Escanear' para comenzar a digitalizar sin configuración previa."
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    FontSize="14" />

                <Button
                    Command="{x:Bind ViewModel.ScanCommand}"
                    IsEnabled="{x:Bind ViewModel.CanScan, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Padding="20,10"
                    Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEC59;" FontSize="16" />
                        <TextBlock Text="Escanear ahora" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Vista de Documento con Miniaturas (1+ páginas) -->
            <ScrollViewer
                Visibility="{x:Bind GetDocumentStateVisibility(ViewModel.HasPages), Mode=OneWay}"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                Padding="24">

                <ItemsControl ItemsSource="{x:Bind ViewModel.Pages, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScannedPageItemViewModel">
                            <controls:PageCardControl ViewModel="{x:Bind Mode=OneWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Fila 4: InfoBar de Notificaciones No Invasivas -->
        <InfoBar
            Grid.Row="4"
            IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=TwoWay}"
            Severity="{x:Bind ViewModel.InfoBarSeverity, Mode=OneWay}"
            Title="{x:Bind ViewModel.InfoBarTitle, Mode=OneWay}"
            Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
            Margin="16,8" />
    </Grid>
</Window>
